pipeline {
    agent any
    stages {
        stage('Build') {
            steps { // Naprawiono literówkę ze 'stesp'
                sh 'npm install'
                sh 'npm run build' // Poprawiono 'npm build' na 'npm run build'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        stage('Deploy') {
            when { 
                branch 'master' // Przeniesiono dyrektywę 'when' przed blok 'steps'
            }
            steps {
                sh 'docker build -t myapp .'
                sh 'docker push myapp:latest'
            }
        }
    }
}